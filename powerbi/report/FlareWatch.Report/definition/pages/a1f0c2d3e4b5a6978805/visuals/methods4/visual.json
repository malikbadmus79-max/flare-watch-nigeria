          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Safe-claim rules",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "10.0pt",
                      "color": "#E8EAED"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Satellite figures are estimates, not measurements. Operators as recorded (World Bank 2026 release); no statement about any company’s conduct.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "7.5pt",
                      "color": "#C9CED6"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Fees implied at regulatory rates; not amounts owed or paid. Residents near sites = proximity only; no exposure or health claim.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "7.5pt",
                      "color": "#C9CED6"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The 2030 path is illustrative, not a forecast.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "7.5pt",
                      "color": "#C9CED6"
